FROM node:24-bookworm-slim AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

COPY . .
# The Railway frontend image builds the full monorepo workspace context. If another
# workspace package gains a dependency before the root lockfile is regenerated,
# --frozen-lockfile blocks an otherwise valid frontend build. Refresh the ephemeral
# lockfile inside the image, then build only the frontend package.
RUN pnpm install --no-frozen-lockfile \
  && pnpm --filter @workspace/frontend build

FROM node:24-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/artifacts/frontend/dist/public ./artifacts/frontend/dist/public
COPY --from=builder /app/artifacts/frontend/railway-server.mjs ./artifacts/frontend/railway-server.mjs

EXPOSE 3000
CMD ["node", "artifacts/frontend/railway-server.mjs"]