{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/content-studio/video/avatar",
      "has": [
        {
          "type": "query",
          "key": "capture",
          "value": "mobile"
        }
      ],
      "destination": "/content-studio/video/avatar/captura",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/obrasgov/:path*",
      "destination": "https://api-publica.obrasgov.gestao.gov.br/obras/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vendorai-platform-replit-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/obrasgov/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=60"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
