{
  "expo": {
    "name": "Vendor.ai",
    "slug": "vendor-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vendorai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appvendorai.vendorai",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para cadastrar produtos, documentos e comprovantes.",
        "NSPhotoLibraryUsageDescription": "Suas fotos podem ser anexadas a produtos, clientes e documentos.",
        "NSLocationWhenInUseUsageDescription": "A localização ajuda no atendimento, nas visitas e na logística da operação."
      }
    },
    "android": {
      "package": "com.appvendorai.vendorai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
