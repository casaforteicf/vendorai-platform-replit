{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "worker": "node --enable-source-maps ./dist/worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:tenant": "tsx ./src/scripts/audit-tenant-isolation.ts",
    "audit:tenant:strict": "tsx ./src/scripts/audit-tenant-isolation.ts --strict",
    "audit:tenant:baseline": "tsx ./src/scripts/audit-tenant-isolation.ts --baseline-high=738",
    "ci:railway": "tsc -p tsconfig.launch-ci.json --noEmit && vitest run src/lib/trial-tenant-resolution.test.ts src/lib/vendorai-subscription-lifecycle.test.ts src/lib/vendorai-subscription-rules.test.ts && pnpm run audit:tenant:baseline && pnpm run build",
    "seed-segment-templates": "tsx ./src/seed-segment-templates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@supabase/supabase-js": "^2.48.0",
    "@types/multer": "^2.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "marked": "^18.0.10",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^25.1.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.8"
  }
}
