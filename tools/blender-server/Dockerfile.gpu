# Arqdor GPU worker for Vast.ai / NVIDIA-enabled Linux hosts.
# Build this separately from the VendorAI API; never deploy it as part of the API container.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ARG BLENDER_VERSION=4.5.14
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BLENDER_PATH=/opt/blender/blender \
    PORT=8080 \
    ARQDOR_CYCLES_GPU_BACKEND=OPTIX \
    ARQDOR_RENDER_WORKERS=1 \
    ARQDOR_RENDER_QUEUE_DB=/var/lib/arqdor-render/jobs.sqlite3 \
    ARQDOR_MODEL_ROOT=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils python3 python3-pip \
      libx11-6 libxi6 libxrender1 libxfixes3 libxxf86vm1 libxrandr2 \
      libsm6 libice6 libgl1 libegl1 libglib2.0-0 libdbus-1-3 \
      libfontconfig1 libgomp1 libtbb12 libxkbcommon0 libvulkan1 \
    && rm -rf /var/lib/apt/lists/*

# Use an official Blender LTS archive and verify it against Blender's published SHA256 manifest.
RUN set -eux; \
    archive="blender-${BLENDER_VERSION}-linux-x64.tar.xz"; \
    base="https://download.blender.org/release/Blender4.5"; \
    curl -fsSL "${base}/${archive}" -o "/tmp/${archive}"; \
    curl -fsSL "${base}/blender-${BLENDER_VERSION}.sha256" -o /tmp/blender.sha256; \
    expected="$(grep -F "${archive}" /tmp/blender.sha256 | awk 'NR==1 {print $1}')"; \
    echo "${expected}" | grep -Eq '^[0-9a-fA-F]{64}$'; \
    printf '%s  %s\n' "${expected}" "/tmp/${archive}" | sha256sum -c -; \
    mkdir -p /opt/blender; \
    tar -xJf "/tmp/${archive}" -C /opt/blender --strip-components=1; \
    rm -f "/tmp/${archive}" /tmp/blender.sha256; \
    /opt/blender/blender --version | head -n 3

WORKDIR /opt/vendorai/blender-server
COPY requirements.txt ./
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements.txt
COPY . ./

RUN useradd --system --uid 10001 --create-home arqdor \
    && mkdir -p /var/lib/arqdor-render /tmp/renders /models /opt/blender/hdri \
    && chown -R arqdor:arqdor /opt/vendorai/blender-server /var/lib/arqdor-render /tmp/renders /models /opt/blender/hdri

USER arqdor
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health | grep -q '"status":"ok"' || exit 1

CMD ["python3", "main.py"]
