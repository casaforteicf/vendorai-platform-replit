{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./runtime-connection-string": "./src/runtime-connection-string.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "homolog:init": "tsx src/prepare-homolog-db.ts && tsx src/seed-homolog-representation.ts",
    "homolog:rebuild": "tsx src/reset-homolog-db.ts && drizzle-kit migrate --config ./drizzle.config.ts && pnpm run migrate && tsx src/seed-homolog-representation.ts",
    "migrate": "tsx src/reconcile-redacted-migration.ts && tsx src/migrate.ts up",
    "migrate:status": "tsx src/migrate.ts status",
    "migrate:dry-run": "tsx src/migrate.ts dry-run",
    "migrate:reconcile-redaction": "tsx src/reconcile-redacted-migration.ts",
    "migrate:reconcile-rls-032": "tsx src/reconcile-rls-032.ts",
    "migrate:reconcile-rls-032-content": "tsx src/reconcile-rls-032-content.ts",
    "migrate:reconcile-rls-033": "tsx src/reconcile-rls-033.ts",
    "migrate:reconcile-content": "tsx src/reconcile-content-drift.ts",
    "diagnose:rls-032": "tsx src/diagnose-rls-032.ts",
    "provision:app-role": "tsx src/provision-app-role.ts",
    "audit:rls": "tsx src/audit-rls.ts",
    "audit:rls:strict": "tsx src/audit-rls.ts --strict",
    "audit:rls:runtime": "tsx src/audit-rls.ts --strict --runtime"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
