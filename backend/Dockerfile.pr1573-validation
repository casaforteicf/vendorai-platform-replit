FROM node:24-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @workspace/api-server exec tsc -p tsconfig.launch-ci.json --noEmit
RUN pnpm --filter @workspace/api-server exec vitest run src/services/guided-video-audio-director.test.ts
RUN pnpm --filter @workspace/api-server run build
RUN pnpm --filter @workspace/frontend run build
CMD ["sh", "-c", "echo 'PR1573 validation complete'; sleep infinity"]