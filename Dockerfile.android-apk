FROM node:22-bookworm AS build

LABEL vendorai.build="android-apk"

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools
ENV CI=true
ENV EXPO_NO_DOTENV=1
ENV PICOVOICE_ACCESS_KEY=

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk wget unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
    && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/android-cmdline \
    && mkdir -p ${ANDROID_HOME}/cmdline-tools/latest \
    && mv /tmp/android-cmdline/cmdline-tools/* ${ANDROID_HOME}/cmdline-tools/latest/ \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

WORKDIR /app
COPY . .

RUN corepack enable \
    && corepack prepare pnpm@10.26.1 --activate \
    && pnpm install --no-frozen-lockfile

RUN cp artifacts/website/public/apple-touch-icon.png artifacts/mobile/assets/images/icon.png \
    && cd artifacts/mobile \
    && pnpm exec expo prebuild --platform android --clean --no-install \
    && cd android \
    && chmod +x gradlew \
    && ./gradlew assembleRelease --no-daemon --stacktrace \
    && /opt/android-sdk/build-tools/35.0.0/apksigner verify --verbose app/build/outputs/apk/release/app-release.apk

FROM nginx:1.27-alpine
COPY --from=build /app/artifacts/mobile/android/app/build/outputs/apk/release/app-release.apk /usr/share/nginx/html/vendorai-1.0.1.apk
RUN cp /usr/share/nginx/html/vendorai-1.0.1.apk /usr/share/nginx/html/vendorai.apk \
    && cat > /usr/share/nginx/html/index.html <<'EOF'
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#090d15">
  <title>VendorAI para Android</title>
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#090d15;color:#fff;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:24px}.card{width:min(100%,460px);text-align:center}.logo{font-size:34px;font-weight:800;letter-spacing:-1.5px;margin-bottom:10px}.logo span{color:#e06f47}.sub{color:#aeb7c5;font-size:16px;line-height:1.5;margin:0 0 28px}.download{display:flex;align-items:center;justify-content:center;width:100%;min-height:58px;border-radius:16px;background:#e06f47;color:#fff;text-decoration:none;font-size:18px;font-weight:800;box-shadow:0 10px 28px rgba(224,111,71,.24)}.download:active{transform:scale(.99)}.note{margin-top:20px;color:#7f8a9a;font-size:13px;line-height:1.5}
  </style>
</head>
<body>
  <main class="card">
    <div class="logo">Vendor<span>AI</span></div>
    <p class="sub">Aplicativo oficial para Android. Toque no botão abaixo para baixar.</p>
    <a class="download" href="/vendorai-1.0.1.apk">Baixar VendorAI</a>
    <p class="note">Após o download, toque no arquivo baixado ou na notificação do Android para iniciar a instalação.</p>
  </main>
</body>
</html>
EOF
RUN mkdir -p /etc/nginx/templates \
    && cat > /etc/nginx/templates/default.conf.template <<'EOF'
server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  types { text/html html; application/vnd.android.package-archive apk; }
  default_type application/octet-stream;

  location = / {
    try_files /index.html =404;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
  }

  location = /health {
    default_type text/plain;
    return 200 "ok";
  }

  location ~ ^/vendorai(-1\.0\.1)?\.apk$ {
    try_files $uri =404;
    add_header Content-Disposition "attachment; filename=VendorAI-1.0.1.apk" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
  }

  location / { return 404; }
}
EOF
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
