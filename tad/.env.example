# Public/auth configuration already used by TAD
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public market/event data
MARKET_EVENT_FEED_URL=
MARKET_EVENT_FEED_TOKEN=

# Private Binance USD-M Futures adapter (server only; never expose with NEXT_PUBLIC_)
BINANCE_FUTURES_PRIVATE_BASE_URL=
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# LIVE requires every independent gate below. Defaults are effectively false when unset.
TAD_LIVE_TRADING_ENABLED=false
TAD_ALLOW_PRODUCTION_EXCHANGE=false

# Recommended rollout:
# 1) use a non-production Binance environment/base URL first;
# 2) pass /api/live/readiness and /api/live/reconcile;
# 3) keep persisted kill_switch=true until controlled activation;
# 4) production host additionally requires TAD_ALLOW_PRODUCTION_EXCHANGE=true.
