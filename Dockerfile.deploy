# Contabo backend release image; build from the immutable repository commit.
FROM public.ecr.aws/docker/library/node:22-bookworm-slim

WORKDIR /app

RUN corepack enable \
  && corepack prepare pnpm@10.26.1 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-liberation chromium \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --no-frozen-lockfile \
  && pnpm --filter @workspace/api-server exec vitest run src/services/vendi-mission-integrity.test.mts src/services/vendi-mission-summary.test.mts \
  && pnpm --filter @workspace/api-server exec tsc -p tsconfig.launch-ci.json --noEmit \
  && pnpm --filter @workspace/api-server run build \
  && pnpm --filter @workspace/frontend run build

ENV NODE_ENV=production

EXPOSE 5000

CMD ["pnpm", "--filter", "@workspace/api-server", "run", "start"]
