# ─── Banco de dados ───────────────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=gere-um-uuid-aqui
SESSION_SECRET=gere-outro-uuid-aqui

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app.appvendorai.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
FRONTEND_APP_URL=https://app.appvendorai.com
GOOGLE_PLACES_API_KEY=

# ─── IA ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_CONFIG_ID=

# ─── Instagram ────────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://appvendorai.com/api/auth/instagram/callback
FRONTEND_APP_URL=https://app.appvendorai.com
INSTAGRAM_PAGE_ACCESS_TOKEN=

# ─── Pagamentos (Asaas) ───────────────────────────────────────────────────────
ASAAS_API_KEY=

# ─── Object Storage ───────────────────────────────────────────────────────────
# ─── Object Storage (Supabase Storage — substitui o antigo Object Storage do Replit) ─────
SUPABASE_URL=https://gfocphuiyyufwzcyihbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_OBJECT_DIR=/app-uploads/private
PUBLIC_OBJECT_SEARCH_PATHS=/app-uploads/public

# ─── Blender Server (renderização 3D — módulo Arch) ───────────────────────────
# URL do Replit com o vendorai-blender-server rodando
# Ex: https://vendorai-blender-server.seuusuario.repl.co
BLENDER_SERVER_URL=

# Mesmo valor de BLENDER_SECRET configurado no servidor Blender
# Gere em: https://www.uuidgenerator.net/
BLENDER_SECRET=

# ─── Domínios personalizados (Cloudflare for SaaS) ───────────────────────────
# Token com permissão para Custom Hostnames na zona appvendorai.com
CLOUDFLARE_API_TOKEN=
# Zone ID da zona usada como SaaS provider
CLOUDFLARE_ZONE_ID=
# Hostname estável/proxied que recebe os CNAMEs dos tenants.
# Configure somente depois de criar e validar o CNAME target/fallback origin no Cloudflare.
# Exemplo de convenção: domains.appvendorai.com
CLOUDFLARE_SAAS_CNAME_TARGET=
# Segredo compartilhado com o Worker de edge que encaminha o domínio real do tenant.
TENANT_EDGE_PROXY_SECRET=
# Compatibilidade temporária com instalações antigas:
# CLOUDFLARE_SAAS_ORIGIN=

# ─── Porta do servidor API ────────────────────────────────────────────────────
PORT=5000

# ─── Canais sociais unificados ───────────────────────────────────────────────
# Cada redirect URI deve terminar em /api/auth/{youtube|linkedin|tiktok}/callback.
PUBLIC_API_URL=https://appvendorai.com
FRONTEND_APP_URL=https://app.appvendorai.com
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://appvendorai.com/api/auth/youtube/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://appvendorai.com/api/auth/linkedin/callback
# Produtos adicionais (Community Management/Marketing) exigem aprovação do LinkedIn.
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202607
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://appvendorai.com/api/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.list,video.upload,video.publish

NUVEM_FISCAL_CLIENT_ID=
NUVEM_FISCAL_CLIENT_SECRET=
NUVEM_FISCAL_AMBIENTE=homologacao

# Vehicle Lookup real via Consulta Online SENATRAN/SERPRO
# Use "mock" somente em desenvolvimento; homologacao/producao usam "senatran".
VEHICLE_LOOKUP_PROVIDER=senatran
VEHICLE_LOOKUP_CACHE_TTL=86400
VEHICLE_LOOKUP_RATE_LIMIT=20
VEHICLE_LOOKUP_TIMEOUT_MS=8000
# homologacao | producao
VEHICLE_LOOKUP_SENATRAN_ENVIRONMENT=homologacao
# Opcional: vazio usa a URL oficial correspondente ao ambiente.
VEHICLE_LOOKUP_SENATRAN_BASE_URL=
# CPF autorizado no contrato, somente números (header x-cpf-usuario).
VEHICLE_LOOKUP_SENATRAN_USER_CPF=
# Informe CERT_BASE64 (recomendado em cloud) OU CERT_PATH.
VEHICLE_LOOKUP_SENATRAN_CERT_BASE64=
VEHICLE_LOOKUP_SENATRAN_CERT_PATH=
VEHICLE_LOOKUP_SENATRAN_CERT_PASSPHRASE=
GOOGLE_DATA_MANAGER_CONVERSIONS_ENABLED=false
GOOGLE_DATA_MANAGER_VALIDATE_ONLY=true
GOOGLE_DATA_MANAGER_TENANT_IDS=


# Google Data Manager — habilitação controlada por tenant
GOOGLE_DATA_MANAGER_CONVERSIONS_ENABLED=false
GOOGLE_DATA_MANAGER_VALIDATE_ONLY=true
# Fail-closed: com a feature ligada e a allowlist vazia, nenhum tenant é processado.
GOOGLE_DATA_MANAGER_TENANT_IDS=
