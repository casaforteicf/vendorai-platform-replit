# ─── Banco de dados ───────────────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=gere-um-uuid-aqui
SESSION_SECRET=gere-outro-uuid-aqui

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# ─── IA ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─── Instagram ────────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=

# ─── Pagamentos (Asaas) ───────────────────────────────────────────────────────
ASAAS_API_KEY=

# ─── Object Storage ───────────────────────────────────────────────────────────
# ─── Object Storage (Supabase Storage — substitui o antigo Object Storage do Replit) ─────
SUPABASE_URL=https://gfocphuiyyufwzcyihbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_OBJECT_DIR=/app-uploads/private
PUBLIC_OBJECT_SEARCH_PATHS=/app-uploads/public

# ─── Blender Server (renderização 3D — módulo Arch) ───────────────────────────
# URL do Replit com o vendorai-blender-server rodando
# Ex: https://vendorai-blender-server.seuusuario.repl.co
BLENDER_SERVER_URL=

# Mesmo valor de BLENDER_SECRET configurado no servidor Blender
# Gere em: https://www.uuidgenerator.net/
BLENDER_SECRET=

# ─── Porta do servidor API ────────────────────────────────────────────────────
PORT=5000
