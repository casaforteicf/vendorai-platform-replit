{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "artifacts/frontend/Dockerfile.railway",
    "watchPatterns": [
      "artifacts/frontend/**",
      "lib/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway.frontend.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
