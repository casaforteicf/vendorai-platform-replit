+/**
+ * Subcategorias reais da vitrine Agro (ex: Tangerinas, Limões, Pêssegos),
+ * no padrão da referência visual Mondini Plantas. Nunca é lista fixa: vem
+ * da especificação "Tipo" que o lojista preenche no produto (mesmo campo
+ * livre label/valor usado no filtro lateral e no compatibilidade veicular),
+ * com a foto do produto mais recente daquele tipo como representante.
+ */
+export async function getAgroSubcategories(limit = 12) {
+  const result = await vendorPool.query(
+    `SELECT spec->>'value' AS nome,
+            count(*)::int AS total,
+            (array_agg(pc.imagem_url ORDER BY pc.created_at DESC)
+              FILTER (WHERE pc.imagem_url IS NOT NULL))[1] AS foto
+     FROM produtos_catalogo pc
+     JOIN tenants t ON t.id = pc.tenant_id
+     JOIN categorias_produto cp ON cp.id = pc.categoria_id
+     JOIN LATERAL jsonb_array_elements(COALESCE(pc.especificacoes, '[]'::jsonb)) AS spec ON true
+     WHERE t.vende_no_praca_ai = true AND pc.ativo = true
+       AND (pc.vende_no_praca_ai_produto IS NULL OR pc.vende_no_praca_ai_produto = true)
+       AND lower(cp.nome) = 'agro'
+       AND spec->>'label' = 'Tipo'
+       AND coalesce(spec->>'value', '') <> ''
+     GROUP BY spec->>'value'
+     ORDER BY total DESC
+     LIMIT $1`,
+    [limit],
+  );
+  return result.rows.map((row) => ({
+    nome: row.nome as string,
+    slug: slugify(row.nome as string),
+    total: row.total as number,
+    foto: (row.foto as string | null) ?? null,
+  }));
+}
