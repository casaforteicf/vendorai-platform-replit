#!/usr/bin/env bash
# Root-installed, fixed-action Contabo operator. NO eval, bash -c, arbitrary paths or free-form commands.
set -Eeuo pipefail
ACTION="${1:-}"
LOT="${2:-}"
[[ ( "$#" -eq 2 || ( "$#" -eq 5 && "$ACTION" == "registerLot" ) ) && "$LOT" =~ ^[A-Z][A-Z0-9]{1,15}-[0-9]{1,6}$ ]] || { echo "INVALID_ARGUMENTS"; exit 64; }
case "$ACTION" in build|homologate|rollback|releaseStatus|preflight|publish|registerLot) ;; *) echo "UNSUPPORTED_ACTION"; exit 64;; esac
LOCK=/run/lock/vendi-operator.lock
exec 9>"$LOCK"
flock -n 9 || { echo "OPERATION_BUSY"; exit 75; }
AUDIT=/var/log/vendi-contabo-operator.log
touch "$AUDIT"; chmod 600 "$AUDIT"
audit(){ printf '%s lot=%s action=%s result=%s\n' "$(date -u +%FT%TZ)" "$LOT" "$ACTION" "$1" >> "$AUDIT"; }
trap 'audit "FAIL_rc$?"' ERR
# Registration is immutable and serialized under the existing operator lock.
# Arguments: registerLot LOT SHA DOCKERFILE CONTEXT
if [[ "$ACTION" == "registerLot" ]]; then
  [[ "$LOT" != "VENDI-02" ]] || { echo LEGACY_LOT_PROTECTED; exit 65; }
  SHA="${3:-}"; DOCKERFILE="${4:-}"; CONTEXT="${5:-}"
  [[ "$SHA" =~ ^[a-f0-9]{40}$ ]] || { echo INVALID_SHA; exit 64; }
  for value in "$DOCKERFILE" "$CONTEXT"; do
    [[ "$value" =~ ^[A-Za-z0-9_./-]+$ && "$value" != /* && "$value" != *..* ]] || { echo INVALID_SOURCE_PATH; exit 64; }
  done
  REPO=/home/vendorai/vendorai-api-auth-test
  [[ -d "$REPO/.git" ]] || { echo REPOSITORY_MISSING; exit 65; }
  git -c safe.directory="$REPO" -C "$REPO" cat-file -e "$SHA^{commit}" || { echo COMMIT_NOT_FETCHED; exit 65; }
  git -c safe.directory="$REPO" -C "$REPO" cat-file -e "$SHA:$DOCKERFILE" || { echo DOCKERFILE_NOT_IN_COMMIT; exit 65; }
  if [[ "$CONTEXT" == "." ]]; then
    [[ "$(git -c safe.directory="$REPO" -C "$REPO" cat-file -t "$SHA^{tree}" 2>/dev/null || true)" == tree ]] || { echo CONTEXT_NOT_DIRECTORY; exit 65; }
  else
    [[ "$(git -c safe.directory="$REPO" -C "$REPO" cat-file -t "$SHA:$CONTEXT" 2>/dev/null || true)" == tree ]] || { echo CONTEXT_NOT_DIRECTORY; exit 65; }
  fi
  DIR=/var/lib/vendi-release/manifests
  install -d -o root -g root -m 0700 "$DIR"
  FILE="$DIR/$LOT.env"
  [[ ! -e "$FILE" && ! -L "$FILE" ]] || { echo LOT_ALREADY_REGISTERED; exit 65; }
  umask 077
  TEMP=$(mktemp "$DIR/.register.XXXXXXXX")
  trap 'rm -f "$TEMP"' EXIT
  printf 'SHA=%s\nDOCKERFILE=%s\nCONTEXT=%s\n' "$SHA" "$DOCKERFILE" "$CONTEXT" > "$TEMP"
  chmod 0600 "$TEMP"
  # Hard link avoids overwriting another concurrently-created manifest.
  ln "$TEMP" "$FILE" || { echo LOT_ALREADY_REGISTERED; exit 65; }
  rm -f "$TEMP"
  trap - EXIT
  audit "REGISTERED_SHA_$SHA"
  echo "LOT_REGISTERED=$LOT SHA=$SHA"
  exit 0
fi
# Stage definitions are fixed, immutable in operator source.
case "$LOT" in
  VENDI-02) ;;
  *) if [[ "$ACTION" == "releaseStatus" && ! -f "/var/lib/vendi-release/manifests/$LOT.env" ]]; then
       # Missing registration is a valid read-only status, not a transport failure.
       echo "LOT=$LOT"
       echo "STATUS=LOT_NOT_REGISTERED"
       echo "BUILD=BLOCKED"
       echo "PRODUCTION=untouched"
       audit "LOT_NOT_REGISTERED_READONLY"
       exit 0
     fi
     if [[ "$ACTION" == "build" || "$ACTION" == "releaseStatus" || "$ACTION" == "publish" || "$ACTION" == "rollback" || "$ACTION" == "homologate" || "$ACTION" == "preflight" ]]; then
       test -f "/var/lib/vendi-release/manifests/$LOT.env" || { echo "LOT_NOT_REGISTERED"; exit 65; }
     else
       echo "UNSUPPORTED_LOT_ACTION"; exit 65
     fi;;
esac
HEALTH=http://127.0.0.1:5000/api/auth/healthz
API=vendorai-homolog-api
BACK=vendorai-homolog-pre-vendi02
check_health(){ curl --fail --silent --max-time 8 "$HEALTH" >/dev/null; }
case "$ACTION" in
  preflight)
    /usr/local/sbin/vendi04-release-preflight "$LOT"
    audit "PREFLIGHT_OK"
    ;;
  publish)
    /usr/local/sbin/vendi04-controlled-release publish "$LOT"
    audit "PUBLISH_COMPLETED"
    ;;
  releaseStatus)
    if [[ "$LOT" != "VENDI-02" ]]; then /usr/local/sbin/vendi04-release-runner status "$LOT"; exit $?; fi
    echo "LOT=$LOT"
    echo "HOMOLOG_HEALTH=$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 8 "$HEALTH" || true)"
    docker inspect "$API" --format 'HOMOLOG={{.State.Status}} IMAGE={{.Config.Image}}'
    if docker inspect "$BACK" >/dev/null 2>&1; then echo "ROLLBACK_BACKUP=present"; else echo "ROLLBACK_BACKUP=missing"; fi
    echo "PRODUCTION=untouched"
    audit "OK"
    ;;
  build)
    /usr/local/sbin/vendi04-release-runner build "$LOT"
    audit "BUILD_REQUEST_COMPLETED"
    ;;
  homologate)
    # For non-legacy lots, test only the exact image already deployed to homologation.
    if [[ "$LOT" != "VENDI-02" ]]; then
      MANIFEST="/var/lib/vendi-release/manifests/$LOT.env"
      BUILDSTATE="/var/lib/vendi-release/state/$LOT"
      [[ "$(stat -c %u "$MANIFEST")" == 0 ]] || { echo MANIFEST_OWNER_INVALID; exit 65; }
      EXPECTED_SHA=$(sed -n 's/^SHA=//p' "$MANIFEST" | head -1)
      [[ "$EXPECTED_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo INVALID_MANIFEST_SHA; exit 65; }
      EXPECTED_IMAGE="vendorai-release:${LOT,,}-${EXPECTED_SHA:0:12}"
      [[ -f "$BUILDSTATE" ]] || { echo BUILD_STATE_MISSING; exit 65; }
      grep -Fxq "SHA=$EXPECTED_SHA" "$BUILDSTATE" &&
      grep -Fxq "IMAGE=$EXPECTED_IMAGE" "$BUILDSTATE" &&
      grep -Fxq "STATUS=BUILT_NOT_DEPLOYED" "$BUILDSTATE" || { echo BUILD_SHA_NOT_VERIFIED; exit 65; }
      ACTUAL_IMAGE=$(docker inspect "$API" --format '{{.Config.Image}}' 2>/dev/null || true)
      [[ "$ACTUAL_IMAGE" == "$EXPECTED_IMAGE" ]] || {
        echo "HOMOLOG_IMAGE_SHA_MISMATCH"
        echo "EXPECTED_SHA=$EXPECTED_SHA"
        echo "HOMOLOG_IMAGE=$ACTUAL_IMAGE"
        exit 65
      }
    fi
    check_health
    TOKEN=$(docker exec vendorai-mcp-contabo-fixed printenv BROWSER_MCP_ACCESS_TOKEN)
    [[ -n "$TOKEN" ]] || { echo "MCP_TOKEN_MISSING"; exit 70; }
    # Read-only API smoke; never print token.
    docker exec -i -e "VENDI_HOMOLOG_AUTH=$TOKEN" "$API" node - <<'JS'
(async()=>{
 const u="http://127.0.0.1:5000/api/internal/browser-mcp/crm-summary";
 async function call(tenant,auth){
  const r=await fetch(u,{method:"POST",headers:{"content-type":"application/json",...(auth?{authorization:"Bearer "+process.env.VENDI_HOMOLOG_AUTH}:{})},body:JSON.stringify({tenantKey:tenant}),signal:AbortSignal.timeout(10000)});
  return {status:r.status,body:await r.json().catch(()=>({}))};
 }
 const unauthorized=await call("krafht-homolog",false);
 const missing=await call("vendi-no-tenant-000000",true);
 const valid=await call("krafht-homolog",true);
 console.log("UNAUTHORIZED_HTTP="+unauthorized.status,"MISSING_HTTP="+missing.status,"CRM_HTTP="+valid.status,"ACTIVE_LEADS="+valid.body.crm?.activeLeads);
 if(unauthorized.status!==401||missing.status!==404||valid.status!==200||!Number.isInteger(valid.body.crm?.activeLeads)) process.exitCode=1;
})().catch(e=>{console.error("SMOKE_FAILED:"+e.message);process.exitCode=1});
JS
    echo "HOMOLOG_SMOKE_PASSED_LOT=$LOT"
    audit "OK"
    ;;
  rollback)
    if [[ "$LOT" != "VENDI-02" ]]; then /usr/local/sbin/vendi04-controlled-release rollback "$LOT"; audit "ROLLBACK_COMPLETED"; exit 0; fi
    [[ -n "${VENDI_ALLOW_ROLLBACK:-}" ]] || { echo "ROLLBACK_REQUIRES_EXPLICIT_INCIDENT_TRIGGER_OR_HOST_POLICY"; audit "DENIED_GUARD"; exit 65; }
    docker inspect "$BACK" >/dev/null 2>&1 || { echo "BACKUP_MISSING"; exit 70; }
    docker stop "$API" >/dev/null
    docker rename "$API" "${API}-replaced-$(date -u +%s)"
    docker rename "$BACK" "$API"
    docker start "$API" >/dev/null
    for i in $(seq 1 30); do if check_health; then echo "ROLLBACK_HEALTH_OK"; audit "OK"; exit 0; fi; sleep 2; done
    echo "ROLLBACK_HEALTH_FAILED"; exit 1
    ;;
esac
