{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vendorai-frontend",
  "main": "artifacts/frontend/cloudflare-worker.ts",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./artifacts/frontend/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/obrasgov/*", "/health"]
  },
  "vars": {
    "API_ORIGIN": "https://vendorai-platform-replit-production.up.railway.app"
  }
}
