FROM node:24-bookworm-slim

# PR 1552 isolated validation
WORKDIR /app
RUN corepack enable
COPY . .

RUN pnpm install --no-frozen-lockfile

# Typecheck only the production files changed by the App Builder PR.
# The monorepo currently has unrelated pre-existing type errors in other modules,
# so this gate must distinguish regressions introduced by this PR.
RUN node -e "const fs=require('fs'); fs.writeFileSync('artifacts/frontend/tsconfig.app-builder-validation.json', JSON.stringify({extends:'./tsconfig.json',include:['src/components/app-builder/TemplateRuntimeEditorDialog.tsx','src/pages/app-runtime/AppRuntimeShell.tsx','src/pages/app-runtime/MobilePresetBlocks.tsx','src/pages/app-runtime/SchemaRuntimeRenderer.tsx'],references:[]},null,2))"
RUN pnpm --filter @workspace/frontend exec tsc -p tsconfig.app-builder-validation.json --noEmit

RUN pnpm --filter @workspace/frontend exec vitest run --config vitest.config.ts src/pages/app-runtime/MobilePresetBlocks.test.tsx src/pages/app-runtime/SchemaRuntimeRenderer.test.tsx
RUN pnpm --filter @workspace/frontend run build

RUN node -e "const fs=require('fs'); fs.writeFileSync('artifacts/api-server/tsconfig.app-builder-validation.json', JSON.stringify({extends:'./tsconfig.json',include:['src/routes/admin_app_builder_standalone.ts'],references:[]},null,2))"
RUN set -eu; \
  output="$(pnpm --filter @workspace/api-server exec tsc -p tsconfig.app-builder-validation.json --noEmit 2>&1 || true)"; \
  printf '%s\n' "$output"; \
  if printf '%s\n' "$output" | grep -F 'src/routes/admin_app_builder_standalone.ts'; then \
    echo 'App Builder API typecheck failed'; \
    exit 1; \
  fi
RUN pnpm --filter @workspace/api-server run build

CMD ["node", "-e", "setInterval(() => {}, 2147483647)"]
