FROM node:24-bookworm-slim

WORKDIR /app
RUN corepack enable
COPY . .

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @workspace/frontend run typecheck
RUN pnpm --filter @workspace/frontend exec vitest run src/pages/app-runtime/MobilePresetBlocks.test.tsx src/pages/app-runtime/SchemaRuntimeRenderer.test.tsx
RUN pnpm --filter @workspace/frontend run build
RUN pnpm --filter @workspace/api-server run typecheck
RUN pnpm --filter @workspace/api-server run build

CMD ["node", "-e", "setInterval(() => {}, 2147483647)"]
