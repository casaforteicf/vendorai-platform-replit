modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-isolation-tests"

[[workflows.workflow]]
name = "api-isolation-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-calendar:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
ASAAS_SANDBOX = "true"
GOOGLE_REDIRECT_URI = "https://ab19153c-024f-4659-a3b1-92ea9524e3c0-00-2d0118focty3z.spock.replit.dev/api/auth/google/calendar/callback"

[userenv.production]
ASAAS_SANDBOX = "false"
GOOGLE_REDIRECT_URI = "https://appvendorai.com/api/auth/google/calendar/callback"

[userenv.shared]
INSTAGRAM_REDIRECT_URI = "https://vendorai.replit.app/api/auth/instagram/callback"
INSTAGRAM_PAGE_ID = "17841423944912998"
WHATSAPP_PHONE_NUMBER_ID = "1182233864978177"
PARTNER_COMMISSION_TIER1 = "30"
PARTNER_COMMISSION_TIER2 = "35"
PARTNER_COMMISSION_TIER3 = "40"
PARTNER_COMMISSION_CLIENTS_TIER1 = "50"
PARTNER_COMMISSION_CLIENTS_TIER2 = "200"
ALERT_EMAIL = "vendorai@appvendorai.com"
RESEND_FROM_EMAIL = "vendorai@appvendorai.com"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18115
externalPort = 3002

[[ports]]
localPort = 18130
externalPort = 3000

[[ports]]
localPort = 19161
externalPort = 3001
