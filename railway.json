{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.android-apk",
    "watchPatterns": [
      "Dockerfile.android-apk",
      "artifacts/mobile/**",
      "artifacts/website/public/apple-touch-icon.png",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 1
  }
}
