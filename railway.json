{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "artifacts/frontend/Dockerfile.recovery",
    "watchPatterns": [
      "artifacts/frontend/**",
      "lib/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "tsconfig.base.json",
      ".npmrc",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node artifacts/frontend/scripts/railway-static-server.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE"
  }
}
