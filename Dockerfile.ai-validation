FROM node:24-bookworm-slim

WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @workspace/api-server run typecheck
RUN pnpm --filter @workspace/api-server exec vitest run src/lib/ai-model-router.test.ts

CMD ["node", "-e", "setInterval(() => {}, 2147483647)"]
